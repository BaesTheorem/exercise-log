#!/usr/bin/env python3
"""Write Fitbit's sleep nights and daily steps into the log for Hitpoints.

Pulls the sleep goal and the last N nights from Fitbit, marks each night
goal-met or not, and merges them over any night the phone claimed; pulls
the daily step series and merges it too. Emits a ``level_up`` event when
Hitpoints crosses a level. Idempotent.

    hitpoints-verify                # last 14 nights, print what changed
    hitpoints-verify --json         # events as JSON (for the watcher)
    hitpoints-verify --dry-run
    hitpoints-verify --goal 450     # override the goal in minutes

Token handling is the same as quest-verify: read-only, never refreshed,
exit 2 when expired.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import quest as q
import skills as sk

DEFAULT_TOKEN = Path.home() / "Documents/Exobrain harness/fitbit-mcp/.fitbit-token.json"
API = "https://api.fitbit.com/1.2/user/-"
API_V1 = "https://api.fitbit.com/1/user/-"
DEFAULT_GOAL_MINUTES = 450


def load_token(path: Path) -> str:
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as e:
        sys.exit(f"cannot read token file {path}: {e}")
    token = data.get("access_token") or data.get("accessToken")
    if not token:
        sys.exit(f"no access_token in {path}")
    return token


def get(token: str, path: str, base: str = API) -> dict:
    req = urllib.request.Request(f"{base}{path}", headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            sys.exit(2)
        sys.exit(f"Fitbit {path}: HTTP {e.code}")


def sleep_goal_minutes(token: str) -> int:
    try:
        return int(get(token, "/sleep/goal.json")["goal"]["minDuration"])
    except (KeyError, ValueError, TypeError):
        return DEFAULT_GOAL_MINUTES


def nights(token: str, days: int, goal: int) -> list[dict]:
    end = datetime.now(timezone.utc).astimezone().date()
    start = end - timedelta(days=days)
    data = get(token, f"/sleep/date/{start:%Y-%m-%d}/{end:%Y-%m-%d}.json")
    by_date: dict[str, int] = {}
    for s in data.get("sleep", []):
        if not s.get("isMainSleep", True):
            continue
        by_date[s["dateOfSleep"]] = max(by_date.get(s["dateOfSleep"], 0), int(s.get("minutesAsleep", 0)))
    return [{"date": d, "minutes": m, "goalMet": m >= goal} for d, m in sorted(by_date.items())]


def step_days(token: str, days: int) -> list[dict]:
    end = datetime.now(timezone.utc).astimezone().date()
    start = end - timedelta(days=days)
    data = get(token, f"/activities/steps/date/{start:%Y-%m-%d}/{end:%Y-%m-%d}.json", base=API_V1)
    return [{"date": r["dateTime"], "steps": int(r["value"])} for r in data.get("activities-steps", [])]


def locate(explicit: str | None) -> Path:
    home = Path.home()
    candidates = [
        home / "Library/Mobile Documents/com~apple~CloudDocs/Exercise Log/exercise-log.json",
        home / "My Drive/Exercise Log/exercise-log.json",
    ]
    if explicit:
        p = Path(explicit).expanduser()
        return p / "exercise-log.json" if p.is_dir() else p
    env = os.environ.get("EXERCISE_LOG_JSON")
    if env:
        return Path(env).expanduser()
    for c in candidates:
        if c.exists():
            return c
    sys.exit("no exercise-log.json found; pass --file")


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--file")
    ap.add_argument("--token-file", default=os.environ.get("FITBIT_TOKEN_FILE", str(DEFAULT_TOKEN)))
    ap.add_argument("--days", type=int, default=14)
    ap.add_argument("--goal", type=int, help="sleep goal in minutes (default: Fitbit's)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    path = locate(args.file)
    data = json.loads(path.read_text())
    token = load_token(Path(args.token_file))
    goal = args.goal or sleep_goal_minutes(token)
    verified = nights(token, args.days, goal)

    before_level = sk.levels(data)["hitpoints"]
    before = json.dumps(data, sort_keys=True)
    data, events = sk.merge_nights(data, verified)
    data, step_events = sk.merge_steps(data, step_days(token, args.days))
    events += step_events
    after_level = sk.levels(data)["hitpoints"]
    if after_level > before_level:
        events.append({"type": "level_up", "skill": "hitpoints", "from": before_level, "to": after_level, "xp": sk.xp("hitpoints", data)})
    changed = json.dumps(data, sort_keys=True) != before
    if changed and not args.dry_run:
        data["updatedAt"] = q.iso(datetime.now(timezone.utc))
        tmp = path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
        tmp.replace(path)

    steps_today = next((d["steps"] for d in data.get("skills", {}).get("steps", [])
                        if d["date"] == datetime.now(timezone.utc).astimezone().date().isoformat()), 0)
    summary = {"goalMinutes": goal, "run": sk.current_sleep_run(data.get("skills", {}).get("nights", [])),
               "stepsToday": steps_today, "level": after_level, "xp": sk.xp("hitpoints", data)}
    if args.json:
        print(json.dumps({"events": events, "changed": changed, "dryRun": args.dry_run, "file": str(path), "summary": summary}))
        return
    for ev in events:
        print(json.dumps(ev))
    print(f"goal {goal} min, run {summary['run']}, {summary['stepsToday']:,} steps today, Hitpoints {summary['level']} ({summary['xp']:,} xp), "
          f"{'written' if changed and not args.dry_run else 'no change'}")


if __name__ == "__main__":
    main()
